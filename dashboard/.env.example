# Copy to .env.local for running on your computer. On Vercel, add these under Project → Settings → Environment Variables.

# Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same Session pooler connection string as the agents use. Server-side only: never prefix it with NEXT_PUBLIC_.
DATABASE_URL=

# Local testing only: skip the email login and act as this staff member or client portal user. Ignored in production.
# DEV_LOGIN_EMAIL=you@example.com
