# Copy to .env and fill in. .env is ignored by git, so your keys stay on your machine.
# Supabase dashboard > Connect (top bar) > Connection string > "Session pooler".
# It looks like: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase dashboard > Project Settings > API. Not needed for the database setup; used later by the app and agents.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses all privacy rules. Server-side only, never in a browser or client portal.
SUPABASE_SERVICE_ROLE_KEY=
