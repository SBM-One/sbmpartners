# Copy to .env and fill in. .env is ignored by git, so your keys stay on your machine.
# Supabase dashboard > Connect (top bar) > Connection string > "Session pooler".
# It looks like: postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Supabase dashboard > Project Settings > API. Not needed for the database setup; used later by the app and agents.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses all privacy rules. Server-side only, never in a browser or client portal.
SUPABASE_SERVICE_ROLE_KEY=

# AI agents. Create a key at console.anthropic.com > API keys. Server-side only, never share it.
ANTHROPIC_API_KEY=

# The Mailer (agents/mailer.py): the mailbox that sends approved emails and reads replies.
# Use a separate sending domain with SPF, DKIM and DMARC set up. Google Workspace: MAIL_PASSWORD is an app password.
MAIL_ADDRESS=
MAIL_PASSWORD=
MAIL_DISPLAY_NAME=
# The dashboard's web address, e.g. https://sbm-dashboard.vercel.app (the unsubscribe page lives there).
UNSUBSCRIBE_URL=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# IMAP_HOST=imap.gmail.com
# MAIL_DRY_RUN=1   writes emails to out/mail/ instead of sending (test databases only)
